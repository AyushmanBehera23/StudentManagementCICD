# Copy to .env (never commit .env). Secrets are NOT stored here: run `make secrets`.
COMPOSE_PROJECT_NAME=school

# Image to run / build. IMAGE_TAG is what deploy.sh and rollback.sh change.
IMAGE=ghcr.io/YOUR_GITHUB_USER/school-attendance-api
IMAGE_TAG=local

# Database (non-secret parts)
DB_NAME=school
DB_USER=school

# App
LOG_LEVEL=INFO
SEED_ON_START=true
TOKEN_TTL_MINUTES=60

# Published ports on the host (reverse proxy only; app and db are not published)
HTTP_PORT=8080
HTTPS_PORT=8443
